PORT=4000
MONGODB_URI=mongodb://localhost:27017/blockwall

# Disbursement addresses buyers pay to (comma-separated).
# Alternatively put a JSON list at backend/payees.json: ["0x...","0x..."]
PAYEES=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222

AUTO_DRIVE_API_KEY=
AUTO_DRIVE_NETWORK=mainnet   # or "taurus" for testnet

# Per-chain contract addresses, filled in after each npm run deploy:*
CONTRACT_ROBINHOOD_CHAIN=
CONTRACT_BASE=
CONTRACT_ARBITRUM=
CONTRACT_OPTIMISM=
CONTRACT_BSC=
CONTRACT_POLYGON=

# JSON-RPC endpoints used to VERIFY buyer payments on-chain (http, not wss)
ROBINHOOD_CHAIN_RPC_URL=https://rpc.robinhoodchain.blockscout.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com

# IMPORTANT: there is NO voucher-signer private key and NO treasury here.
# The operator mints with a key supplied only at mint time
# (contracts/scripts/finalize.js), never stored in .env.